# Kopiera till Vercel → Project → Settings → Environment Variables.
# Allt markerat KRÄVS.

# Valfritt på Vercel (hittas automatiskt). Krävs på andra värdar. Utan / på slutet.
# NEXT_PUBLIC_APP_URL=https://andrum.vercel.app

# KRÄVS – Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# KRÄVS – Stripe → Developers → API keys (börja med sk_test_..., byt till sk_live_... när allt funkar)
STRIPE_SECRET_KEY=sk_test_...

# KRÄVS – Resend → API Keys, och en avsändaradress på en domän du verifierat i Resend
RESEND_API_KEY=re_...
EMAIL_FROM=bokning@dindoman.se

# KRÄVS – din egen e-post. Du blir superadmin och ser alla studios.
SUPERADMIN_EMAILS=du@exempel.se

# Valfritt
PLATFORM_NAME=Andrum
# true = vem som helst kan skapa en egen studio (när du vill sälja självbetjänat)
ALLOW_SIGNUP=false
